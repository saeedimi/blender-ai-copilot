{
  "name": "memory",
  "description": "Multi-turn referential-memory suite.",
  "cases": [
    {
      "id": "object_pronoun_color",
      "description": "Create an object, then resolve 'it' deterministically and assign a dedicated material.",
      "turns": [
        {
          "prompt": "Create a UV sphere named EvalMemorySphere_{run_id} at ({ox}, {oy}, 12).",
          "expect": {
            "required_tools": [
              "create_uv_sphere"
            ],
            "required_goal_tools": [
              "create_uv_sphere"
            ],
            "max_tool_repeats": {
              "create_uv_sphere": 1
            },
            "max_render_executions": 0
          }
        },
        {
          "prompt": "Make it blue.",
          "expect": {
            "required_tools": [
              "create_material",
              "assign_material"
            ],
            "forbidden_tools": [
              "set_material_color"
            ],
            "required_discovered_tools": [
              "create_material",
              "assign_material"
            ],
            "forbidden_discovered_tools": [
              "set_material_color"
            ],
            "required_events": [
              "reference_resolved"
            ],
            "reference_target": {
              "type": "object",
              "name": "EvalMemorySphere_{run_id}"
            },
            "tool_argument_equals": [
              {
                "tool": "assign_material",
                "path": "object_name",
                "value": "EvalMemorySphere_{run_id}"
              }
            ],
            "max_tool_repeats": {
              "create_material": 1,
              "assign_material": 1
            },
            "max_render_executions": 0,
            "max_llm_calls": 6,
            "max_total_seconds": 120,
            "forbidden_final_answer_terms": [
              "smooth"
            ]
          }
        },
        {
          "prompt": "Shade it smooth.",
          "expect": {
            "required_tools": [
              "shade_smooth"
            ],
            "required_events": [
              "reference_resolved",
              "deterministic_goal_tool_injected"
            ],
            "reference_target": {
              "type": "object",
              "name": "EvalMemorySphere_{run_id}"
            },
            "tool_argument_equals": [
              {
                "tool": "shade_smooth",
                "path": "object_name",
                "value": "EvalMemorySphere_{run_id}"
              }
            ],
            "max_tool_repeats": {
              "shade_smooth": 1
            },
            "max_render_executions": 0
          }
        }
      ]
    }
  ]
}